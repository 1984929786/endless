<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) 起默认禁止明文 HTTP（usesCleartextTraffic 默认 false）。
  App 要连本机 OpenClaw 网关 ws/http://127.0.0.1:18789，必须显式放行。

  只放行回环地址，不放行外网：即使 token 泄露，也无法把请求发到外部明文 HTTP。
  2026-11-21 踩坑：不加这份配置，AgentClient 所有请求抛
  "Cleartext HTTP traffic to 127.0.0.1 not permitted"，静默回退本地模型。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
